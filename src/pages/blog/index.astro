---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/en/Layout.astro';

const posts = await getCollection('posts', ({ data }) => data.lang === 'en');
posts.sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Layout>
	<div class="max-w-7xl mx-auto px-6 py-12 pb-20">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
			{posts.map((post) => (
				<a href={`/blog/posts/${post.data.slug}`} class="group block rounded-xl overflow-hidden bg-white border border-slate/20 shadow-sm transition-all duration-200 hover:shadow-xl hover:-translate-y-0.5">
					<div class="aspect-[16/9]">
						<img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover object-top" />
					</div>
					<div class="p-5">
						<h2 class="text-lg font-semibold m-0 decoration-cyber underline-offset-4 group-hover:underline transition-colors duration-200">{post.data.title}</h2>
						<p class="text-sm text-slate mt-2 mb-0">{post.data.description}</p>
					</div>
				</a>
			))}
		</div>
	</div>
</Layout>
