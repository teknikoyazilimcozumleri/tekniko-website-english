---
export interface Props {
	title: string;
	image?: string;
	tags?: string[];
}

const { title, image, tags = [] } = Astro.props;
---

<article class="max-w-4xl mx-auto px-6 py-12">
	{image && (
		<div class="mb-8">
			<img src={image} alt={title} class="w-full h-auto rounded border border-slate/30" />
		</div>
	)}

	<div class="mb-6">
		<h1 class="text-3xl font-semibold leading-tight m-0">{title}</h1>
		{tags.length > 0 && (
			<ul class="flex flex-wrap gap-2 mt-4 p-0 list-none">
				{tags.map((tag) => (
					<li class="m-0"><span class="text-xs px-2 py-1 rounded-full border border-slate/30 text-slate">{tag}</span></li>
				))}
			</ul>
		)}
	</div>

	<section class="blog-content max-w-none leading-relaxed text-navy">
		<slot />
	</section>
</article>

<style>
	.blog-content :global(h2) {
		font-size: 1.5rem;
		font-weight: 600;
		margin: 0;
		padding-top: 1.5rem;
		padding-bottom: 1rem;
	}

	.blog-content :global(p) {
		margin: 0 0 1rem;
	}

	.blog-content :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.5rem;
		list-style: disc;
	}

	.blog-content :global(li) {
		margin: 0.35rem 0;
	}

	.blog-content :global(hr) {
		margin: 2rem 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--color-slate) 35%, white);
	}

	.blog-content :global(table) {
		width: 100%;
		margin: 0 0 1.5rem;
		border-collapse: collapse;
		table-layout: fixed;
		font-size: 0.95rem;
	}

	.blog-content :global(th),
	.blog-content :global(td) {
		border: 1px solid color-mix(in srgb, var(--color-slate) 35%, white);
		padding: 0.75rem 0.9rem;
		text-align: left;
		vertical-align: top;
		white-space: normal;
		overflow-wrap: break-word;
	}

	.blog-content :global(th) {
		background: var(--color-navy);
		color: var(--color-ice);
		font-weight: 600;
	}

	.blog-content :global(tbody tr:nth-child(even) td) {
		background: color-mix(in srgb, var(--color-slate) 8%, white);
	}
</style>
